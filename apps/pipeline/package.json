{
  "name": "@artduo/pipeline",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@xenova/transformers": "2.17.2",
    "@artduo/corpus": "workspace:*",
    "@artduo/contracts": "workspace:*",
    "ipaddr.js": "2.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @artduo/contracts build && pnpm --filter @artduo/corpus build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @artduo/contracts build && pnpm --filter @artduo/corpus build && tsx --test src/*.test.ts",
    "workspace:prepare": "pnpm --filter @artduo/contracts build && pnpm --filter @artduo/corpus build",
    "build:metadata": "pnpm run workspace:prepare && tsx src/build-artwork-metadata-shards.ts",
    "build:search": "pnpm run workspace:prepare && tsx src/build-search-shards.ts",
    "build:media-index": "pnpm run workspace:prepare && tsx src/build-media-index.ts",
    "build:background-scenes": "pnpm run workspace:prepare && tsx src/build-background-scenes.ts",
    "build:embeddings": "pnpm run workspace:prepare && tsx src/build-embedding-shards.ts",
    "build:image-embeddings": "pnpm run workspace:prepare && tsx src/build-image-embedding-shards.ts",
    "debug:image-embeddings": "pnpm run workspace:prepare && tsx src/debug-image-embedding.ts",
    "bench:image-embeddings": "pnpm run workspace:prepare && tsx src/run-image-embedding-evaluation.ts",
    "debug:vector-retrieval": "pnpm run workspace:prepare && tsx src/debug-vector-retrieval.ts",
    "bench:vector": "pnpm run workspace:prepare && tsx src/run-vector-benchmark.ts",
    "bench:vector:provider": "pnpm run workspace:prepare && tsx src/run-vector-provider-benchmark.ts",
    "relationship-graph:phase0": "pnpm run workspace:prepare && tsx src/build-relationship-graph-phase0.ts",
    "build:relationship-graph": "pnpm run workspace:prepare && tsx src/build-relationship-graph.ts",
    "relationship-graph:evaluate": "pnpm run workspace:prepare && tsx src/run-relationship-graph-evaluation.ts",
    "build:visual-presentation-preview": "pnpm run workspace:prepare && tsx src/build-visual-presentation-preview.ts",
    "build:candidate-preview": "pnpm run workspace:prepare && tsx src/build-candidate-preview.ts",
    "build:confirmed-metadata-backfill": "pnpm run workspace:prepare && tsx src/build-confirmed-metadata-backfill.ts",
    "build:metadata-backfill-preview": "pnpm run workspace:prepare && tsx src/build-metadata-backfill-preview.ts",
    "build:quantity-preview": "pnpm run workspace:prepare && tsx src/build-quantity-preview.ts",
    "build:release-ready": "pnpm run workspace:prepare && tsx src/build-release-ready-corpus.ts",
    "build:release": "pnpm run workspace:prepare && tsx src/build-release-manifest.ts",
    "met:probe": "node ../../scripts/collect/met-probe.js",
    "met:batch": "node ../../scripts/collect/met-batch.js",
    "met:backfill-batch-probe-approval": "node ../../scripts/collect/backfill-batch-probe-approval.js"
  }
}
