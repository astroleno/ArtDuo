{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artduo.local/schemas/image-embedding-reproducibility-evidence.v1.json",
  "title": "ArtDuo image embedding reproducibility evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseVersion",
    "generatedAt",
    "execution",
    "environment",
    "inputs",
    "runtimeArtifacts",
    "resolvedDependencies",
    "runs",
    "outputs",
    "promotionState"
  ],
  "properties": {
    "schemaVersion": { "const": "artduo-image-embedding-reproducibility-evidence.v1" },
    "releaseVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitSha", "treeSha", "trackedGitStatusBeforeRuns", "untrackedPromotionArtifactsExcluded"],
      "properties": {
        "commitSha": { "$ref": "#/$defs/gitSha" },
        "treeSha": { "$ref": "#/$defs/gitSha" },
        "trackedGitStatusBeforeRuns": { "const": "clean" },
        "untrackedPromotionArtifactsExcluded": { "const": true }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "architecture", "nodeVersion", "pnpmVersion"],
      "properties": {
        "operatingSystem": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "nodeVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+" },
        "pnpmVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/fileBinding" }, { "properties": { "path": { "const": "package.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/fileBinding" }, { "properties": { "path": { "const": "apps/pipeline/package.json" } } }] },
        { "allOf": [{ "$ref": "#/$defs/fileBinding" }, { "properties": { "path": { "const": "pnpm-lock.yaml" } } }] },
        { "allOf": [{ "$ref": "#/$defs/fileBinding" }, { "properties": { "path": { "pattern": "^data/releases/[^/]+/manifest\\.json$" } } }] },
        { "allOf": [{ "$ref": "#/$defs/fileBinding" }, { "properties": { "path": { "pattern": "^data/curation/reports/image-embeddings/[^/]+/promotion-anchor-set\\.json$" } } }] },
        { "allOf": [{ "$ref": "#/$defs/fileBinding" }, { "properties": { "path": { "pattern": "^data/curation/reports/image-embeddings/[^/]+/image-embedding-report\\.json$" } } }] }
      ],
      "items": false
    },
    "runtimeArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "sourceCache"],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision", "variant", "artifact", "sizeBytes", "checksum"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "variant": { "type": "string", "minLength": 1 },
            "artifact": { "type": "string", "minLength": 1 },
            "sizeBytes": { "type": "integer", "minimum": 1 },
            "checksum": { "$ref": "#/$defs/checksum" }
          }
        },
        "sourceCache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "fileCount", "aggregateAlgorithm", "aggregateChecksum", "committed"],
          "properties": {
            "schema": { "const": "artduo-image-source-cache.v1" },
            "fileCount": { "type": "integer", "minimum": 1 },
            "aggregateAlgorithm": { "const": "sha256(concat(sortByRelativePath(fileSha256 + twoSpaces + relativePath + newline)))" },
            "aggregateChecksum": { "$ref": "#/$defs/checksum" },
            "committed": { "const": false }
          }
        }
      }
    },
    "resolvedDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@xenova/transformers", "sharp", "commander", "ipaddr.js"],
      "properties": {
        "@xenova/transformers": { "type": "string" },
        "sharp": { "type": "string" },
        "commander": { "type": "string" },
        "ipaddr.js": { "type": "string" }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/normalInstallRun" },
        { "$ref": "#/$defs/offlineInstallRun" },
        { "$ref": "#/$defs/providerSmokeRun" },
        { "$ref": "#/$defs/offlineBuildRun" }
      ],
      "items": false
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "offlineReport"],
      "properties": {
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["committed", "recordCount", "declaredChecksum", "bytesChecksum"],
          "properties": {
            "committed": { "const": false },
            "recordCount": { "type": "integer", "minimum": 1 },
            "declaredChecksum": { "$ref": "#/$defs/checksum" },
            "bytesChecksum": { "$ref": "#/$defs/checksum" }
          }
        },
        "offlineReport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sizeBytes", "bytesChecksum", "coverageReady", "controlledFailures"],
          "properties": {
            "sizeBytes": { "type": "integer", "minimum": 1 },
            "bytesChecksum": { "$ref": "#/$defs/checksum" },
            "coverageReady": { "type": "boolean" },
            "controlledFailures": { "type": "array", "items": { "$ref": "#/$defs/failure" } }
          }
        }
      }
    },
    "promotionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotionReady",
        "task6Authorized",
        "artworkHoldoutAccuracy",
        "artworkHoldoutLowerConfidence",
        "sceneTop3HitRate",
        "sceneTop3LowerConfidence",
        "humanReviewCompleted",
        "humanReviewRequired"
      ],
      "properties": {
        "promotionReady": { "type": "boolean" },
        "task6Authorized": { "type": "boolean" },
        "artworkHoldoutAccuracy": { "$ref": "#/$defs/ratio" },
        "artworkHoldoutLowerConfidence": { "$ref": "#/$defs/ratio" },
        "sceneTop3HitRate": { "$ref": "#/$defs/ratio" },
        "sceneTop3LowerConfidence": { "$ref": "#/$defs/ratio" },
        "humanReviewCompleted": { "type": "integer", "minimum": 0 },
        "humanReviewRequired": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "promotionReady": { "const": true } }, "required": ["promotionReady"] },
          "then": { "properties": { "task6Authorized": { "const": true } } },
          "else": { "properties": { "task6Authorized": { "const": false } } }
        }
      ]
    }
  },
  "$defs": {
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "checksum"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.$).+$" },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityType", "entityId", "code"],
      "properties": {
        "entityType": { "enum": ["artwork", "background-scene"] },
        "entityId": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 }
      }
    },
    "baseRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "exitCode", "trackedGitStatusAfterRun", "log"],
      "properties": {
        "id": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "exitCode": { "const": 0 },
        "trackedGitStatusAfterRun": { "const": "clean" },
        "log": { "$ref": "#/$defs/fileBinding" }
      }
    },
    "normalInstallRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "isolation", "nativeScriptsEnabled", "exitCode", "trackedGitStatusAfterRun", "log"],
      "properties": {
        "id": { "const": "normal-frozen-install" },
        "command": { "const": "pnpm install --frozen-lockfile --registry=https://registry.npmjs.org" },
        "isolation": { "const": "detached sparse checkout at execution.commitSha" },
        "nativeScriptsEnabled": { "const": true },
        "exitCode": { "const": 0 },
        "trackedGitStatusAfterRun": { "const": "clean" },
        "log": { "$ref": "#/$defs/fileBinding" }
      }
    },
    "offlineInstallRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "isolation", "nativeScriptsEnabled", "exitCode", "trackedGitStatusAfterRun", "log"],
      "properties": {
        "id": { "const": "offline-frozen-install" },
        "command": { "const": "pnpm install --frozen-lockfile --offline" },
        "isolation": { "const": "detached sparse checkout at execution.commitSha" },
        "nativeScriptsEnabled": { "const": true },
        "exitCode": { "const": 0 },
        "trackedGitStatusAfterRun": { "const": "clean" },
        "log": { "$ref": "#/$defs/fileBinding" }
      }
    },
    "providerSmokeRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "exitCode", "trackedGitStatusAfterRun", "log"],
      "properties": {
        "id": { "const": "real-provider-smoke" },
        "command": { "const": "ARTDUO_RUN_REAL_IMAGE_EMBEDDING_SMOKE=true pnpm --filter @artduo/pipeline exec tsx --test src/image-embedding-provider.real.test.ts" },
        "exitCode": { "const": 0 },
        "trackedGitStatusAfterRun": { "const": "clean" },
        "log": { "$ref": "#/$defs/fileBinding" }
      }
    },
    "offlineBuildRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "exitCode", "trackedGitStatusAfterRun", "log"],
      "properties": {
        "id": { "const": "offline-shadow-rebuild" },
        "command": { "type": "string", "pattern": "^pnpm image-embeddings:build -- --release-version [^ ]+ --image-embedding-model [^ ]+ --image-embedding-model-revision [^ ]+ --image-embedding-model-variant [^ ]+ --image-embedding-batch-size 8 --offline true --report-root <TEMP_REPORT_ROOT> --promotion-anchor-set data/curation/reports/image-embeddings/[^/]+/promotion-anchor-set\\.json$" },
        "exitCode": { "const": 0 },
        "trackedGitStatusAfterRun": { "const": "clean" },
        "log": { "$ref": "#/$defs/fileBinding" }
      }
    }
  }
}
