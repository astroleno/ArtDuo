{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artduo.local/schemas/image-embedding-reproducibility-bundle.v1.json",
  "title": "ArtDuo image embedding reproducibility bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseVersion", "evidence", "offlineBuildManifest", "artifactRetention"],
  "properties": {
    "schemaVersion": { "const": "artduo-image-embedding-reproducibility-bundle.v1" },
    "releaseVersion": { "type": "string", "minLength": 1 },
    "evidence": { "$ref": "#/$defs/fileBinding" },
    "offlineBuildManifest": { "$ref": "#/$defs/fileBinding" },
    "artifactRetention": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "task7Ready", "immutableArtifacts"],
          "properties": {
            "status": { "const": "local-only" },
            "task7Ready": { "const": false },
            "immutableArtifacts": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "task7Ready", "immutableArtifacts"],
          "properties": {
            "status": { "const": "immutable-storage" },
            "task7Ready": { "const": true },
            "immutableArtifacts": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                { "$ref": "#/$defs/modelArtifact" },
                { "$ref": "#/$defs/sourceCacheArtifact" },
                { "$ref": "#/$defs/candidateArtifact" },
                { "$ref": "#/$defs/offlineReportArtifact" }
              ],
              "items": false
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "checksum"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\./(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[^\\\\]+$" },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "artifactBaseProperties": {
      "kind": { "type": "string" },
      "uri": { "type": "string", "pattern": "^https://[^/?#]+(?:[/?#]|$)" },
      "sizeBytes": { "type": "integer", "minimum": 1 },
      "checksum": { "$ref": "#/$defs/checksum" }
    },
    "modelArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sizeBytes", "checksum"],
      "properties": {
        "kind": { "const": "model" },
        "uri": { "type": "string", "pattern": "^https://[^/?#]+(?:[/?#]|$)" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "sourceCacheArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sizeBytes", "checksum", "archiveFormat", "contentFileCount", "contentAggregateChecksum"],
      "properties": {
        "kind": { "const": "source-cache" },
        "uri": { "type": "string", "pattern": "^https://[^/?#]+(?:[/?#]|$)" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/$defs/checksum" },
        "archiveFormat": { "const": "artduo-source-cache-tar-ustar.v1" },
        "contentFileCount": { "type": "integer", "minimum": 1 },
        "contentAggregateChecksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "candidateArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sizeBytes", "checksum"],
      "properties": {
        "kind": { "const": "candidate" },
        "uri": { "type": "string", "pattern": "^https://[^/?#]+(?:[/?#]|$)" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "offlineReportArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sizeBytes", "checksum"],
      "properties": {
        "kind": { "const": "offline-report" },
        "uri": { "type": "string", "pattern": "^https://[^/?#]+(?:[/?#]|$)" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/$defs/checksum" }
      }
    }
  }
}
