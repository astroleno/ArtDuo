# Copy to a private service EnvironmentFile on the chosen host.
# This example contains no working credentials and does not publish anything.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
ARTDUO_PUBLIC_MODE=1
ARTDUO_BASE_PATH=/ArtDuo
ARTDUO_MEDIA_MODE=local
# Enable only after the complete public media manifest and uploaded objects are verified.
# ARTDUO_MEDIA_ORIGIN=https://assets.aitoshuu.me
# ARTDUO_MEDIA_MANIFEST=data/releases/2026-10-24-da3-curated-630/public-media-manifest.json
ARTDUO_PUBLIC_ORIGIN=https://aitoshuu.me
ARTDUO_PUBLIC_ORIGINS=https://tongye.me
ARTDUO_STATE_DIR=/var/lib/artduo
ARTDUO_TRUSTED_PROXY_HEADER=x-real-ip
# Generate a private random value of at least 32 characters on the host.
ARTDUO_REQUEST_SALT=replace-with-a-private-random-value
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=replace-on-host
ARTDUO_EXPLANATION_PROVIDER=openai-compatible
ARTDUO_MODEL_CONCURRENCY=3
ARTDUO_MODEL_DAILY_REQUESTS=200
ARTDUO_MODEL_DAILY_TOKENS=1000000
ARTDUO_VISITOR_REQUESTS_PER_MINUTE=8
INKO_API_BASE=https://api.inkotype.com/v1
INKO_API_KEY=replace-on-host
# Worker has its own persistent coordination directory and enforces zero-price quotes.
INKO_COORDINATION_DIR=/var/lib/artduo/handwriting/coordination
