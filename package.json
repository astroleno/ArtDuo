{
  "name": "artduo",
  "private": true,
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @artduo/web test:e2e",
    "preflight:check": "pnpm test && pnpm typecheck && pnpm build && pnpm test:e2e",
    "collect:met:test": "node scripts/collect/met-collect.js --test",
    "collect:met:phase": "node scripts/collect/met-collect.js --phase",
    "collect:met:emotion": "node scripts/collect/met-collect.js --emotion",
    "collect:met:probe": "pnpm --filter @artduo/pipeline met:probe",
    "collect:met:batch": "pnpm --filter @artduo/pipeline met:batch",
    "collect:met:backfill-batch-probe-approval": "pnpm --filter @artduo/pipeline met:backfill-batch-probe-approval",
    "collect:review:bootstrap": "node scripts/collect/bootstrap-review-pass.js",
    "collect:review:summary": "node scripts/collect/build-review-summary.js",
    "collect:metadata-backfill": "pnpm --filter @artduo/pipeline build:confirmed-metadata-backfill",
    "collect:metadata-preview": "pnpm --filter @artduo/pipeline build:metadata-backfill-preview",
    "collect:candidate-preview": "pnpm --filter @artduo/pipeline build:candidate-preview",
    "collect:quantity-preview": "pnpm --filter @artduo/pipeline build:quantity-preview",
    "collect:release-ready": "pnpm --filter @artduo/pipeline build:release-ready",
    "vector:debug": "pnpm --filter @artduo/pipeline debug:vector-retrieval",
    "vector:benchmark": "pnpm --filter @artduo/pipeline bench:vector",
    "vector:benchmark:provider": "pnpm --filter @artduo/pipeline bench:vector:provider"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "hnswlib-node": "^3.0.0",
    "natural": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
