{"id":"1170033833_object","created":"2020-03-21T15:03:50Z","modified":"2026-11-17T09:17:07Z","collection":[""],"acquisition_date":"1700-01-01T00:00:00Z","acquisition_date_precision":"1799-12-31","dimensions":[{"part":"Brutto","type":"width","unit":"cm","value":"48.5"},{"part":"Brutto","type":"height","unit":"cm","value":"58"},{"notes":"475 x 395 mm","part":"Netto","type":"height","unit":"cm","value":"47.5"},{"notes":"475 x 395 mm","part":"Netto","type":"width","unit":"cm","value":"39.5"}],"materials":["canvas"],"object_names":[{"name":"Painting"}],"production":[{"creator":"Schalcken, Godefridus","creator_forename":"Godefridus","creator_surname":"Schalcken","creator_date_of_birth":"1643-01-01T00:00:00.000Z","creator_date_of_death":"1706-01-01T00:00:00.000Z","creator_nationality":"Dutch","creator_gender":"MALE","creator_history":"Godfried Schalcken opholdt sig måske aldrig i København, og i bestallingen nævnes ikke løn, men privilegier som andre hofbetjente. S. videreførte traditionen med små intime natstykker, ofte af lidt koket genreagtigt indhold, som Gerrit Dou havde gjort populære. Gennem sine forsøg som historiemaler frigjorde S. sig dog mere og mere fra sine læreres indflydelse. Der blev allerede i kunstnerens levetid indkøbt arbejder til de kongelige samlinger på Rosenborg og Kunstkammeret. Kunsthandleren Gerhard Morell, der fra 1759 var kunstkammerforvalter, indkøbte bl.a. Den bodfærdige Marie Magdalene til Fredensborg Slot i 1760.","creator_lref":"1920_person"}],"production_date":[{"start":"1658-01-01T00:00:00.000Z","end":"1706-12-31T00:00:00.000Z","period":"1658-1706"}],"techniques":["Oil on canvas"],"titles":[{"title":"Susanna and the Elders","language":"engelsk"}],"number_of_parts":1,"object_number":"KMSst174","object_url":"https://api.smk.dk/api/v1/art?object_number=KMSst174","frontend_url":"https://open.smk.dk/artwork/image/KMSst174","iiif_manifest":"https://api.smk.dk/api/v1/iiif/manifest?id=KMSst174","enrichment_url":"https://enrichment.api.smk.dk/api