{"data":{"id":235046,"api_model":"artworks","api_link":"https:\/\/api.artic.edu\/api\/v1\/artworks\/235046","is_boosted":false,"title":"The Harvest of Buckwheat","alt_titles":[],"thumbnail":{"lqip":"data:image\/gif;base64,R0lGODlhAwAFAPMAACsiFy4hFjEnGT8mGEMnGkEoGUAyI0syI1c+KmE1JVpAKmJCKmpJNmpJOHpaQQAAACH5BAAAAAAALAAAAAADAAUAAAQL0LEWgEjHLIXKIBEAOw==","width":1352,"height":2250,"alt_text":"A work made of oil on canvas."},"main_reference_number":"2016.123","has_not_been_viewed_much":false,"boost_rank":null,"date_start":1899,"date_end":1899,"date_display":"1899","date_qualifier_title":"Made","date_qualifier_id":4,"artist_display":"Paul S\u00e9rusier  (French, 1864\u20131927)","place_of_origin":"France","description":"<p><em>The Harvest of Buckwheat<\/em> demonstrates how Paul S\u00e9rusier\u2019s interest in Japanese art influenced his painting. The simplified forms and asymmetrical composition are elements also found in Japanese prints, which circulated widely in France in the late 1800s. The vertical format, too, recalls the panels of Japanese wall hangings or screens.<\/p>\n<p>S\u00e9rusier shared an affinity for Japanese aesthetics with his fellow members of the Nabis, a group of artists whose name, coined by poet Henri Cazalis, comes from the Hebrew word for <em>prophet<\/em>. The group believed that painting should be decorative as opposed to purely representational. As a result, they sought formats and approaches that departed from traditional easel painting.<\/p>\n","short_description":null,"dimensions":"129.5 \u00d7 78.5 cm (51 \u00d7 30 7\/8 in.)","dimensions_detail":[{"depth":null,"width":78,"height":129,"diameter":null,"clarification":null}],"medium_display":"Oil on canvas","inscriptions":"Signed and dated lower left: P. S\u00e9r, 99","credit_line":"Gift of Lucia Woods Lindley","catalogue_display":null,"publication_history":null,"exhibition_history":null,"provenance_text":"Sold to Louis Jouvet (died 1951), Paris, by 1950 [acquired either directly from artist (died 1927) or from the artist\u2019s wife, Marguerite S\u00e9rusier (died 1950), according to email from Caroline Boyle-Turner to Gloria Groom, March 12, 2016]. Sold to Mme Gu\u00e9gan, Ch\u00e2teauneuf-du-Faou, France, by 1976; sold Thierry & Lannon Auctioneers, Brest, May 12, 2002, lot 219, to Galerie Fabien Boulakia, Paris; sold to Lucia Woods Lindley, New York, 2004 [receipt in curatorial file]; given to the Art Institute of Chicago, 2016.","edition":null,"publishing_verification_level":"Web Cataloged","internal_department_id":14,"fiscal_year":2016,"fiscal_year_deaccession":null,"is_public_domain":true,"is_zoomable":true,"max_zoom_window_size":-1,"copyright_notice":null,"has_multimedia_resources":false,"has_educational_resources":false,"has_advanced_imaging":false,"colorfulness":34.0989,"color":{"h":40,"l":23,"s":32,"percentage":0.04244421164949875,"population":502},"latitude":null,"longitude":null,"latlon":null,"is_on_view":true,"on_loan_display":null,"gallery_title":"Gallery 241","gallery_id":2147479705,"nomisma_id":null,"artwork_type_title":"Painting","artwork_type_id":1,"department_title":"Painting and Sculpture of Europe","department_id":"PC-10","artist_id":22687,"artist_title":"Paul S\u00e9rusier","alt_artist_ids":[],"artist_ids":[22687],"artist_titles":["Paul S\u00e9rusier"],"category_ids":["PC-10"],"category_titles":["Painting and Sculpture of Europe"],"term_titles":["landscape","nineteenth century","oil painting","oil paint (paint)","painting","work","woman","trees","man","labor","hills","flowers","figures","farm","nabis","19th century","painting techniques","painting (image making)","painting","painting","paint","canvas","oil on canvas","oil paintings (visual works)","paint","french"],"style_id":"TM-15636","style_title":"nineteenth century","alt_style_ids":["TM-10343","TM-13203"],"style_ids":["TM-15636","TM-10343","TM-13203"],"style_titles":["nineteenth century","nabis","19th century"],"classification_id":"TM-9","classification_title":"painting","alt