{"id":"1170070932_object","created":"2020-03-21T21:57:19Z","modified":"2025-07-11T17:59:07Z","acquisition_date":"2005-01-24T00:00:00Z","acquisition_date_precision":"2005-01-24","dimensions":[{"notes":"1050 x 2425 mm","part":"Netto","type":"height","unit":"cm","value":"105"},{"notes":"1050 x 2425 mm","part":"Netto","type":"width","unit":"cm","value":"242.5"}],"documentation":[{"title":"I stor stil: Jens Adolf Jerichau & Co.","author":"Nils Ohrt","notes":"Omt. p. 19. Afb. p. 16","shelfmark":"ka2004-066","year_of_publication":"2004"}],"materials":["canvas"],"object_names":[{"name":"Painting"}],"production":[{"creator":"Rosenberg, Ivar","creator_forename":"Ivar","creator_surname":"Rosenberg","creator_date_of_birth":"1891-06-01T00:00:00.000Z","creator_date_of_death":"1924-05-02T00:00:00.000Z","creator_nationality":"Danish","creator_gender":"MALE","creator_history":"Ivar Rosenberg tilhørte den generation af unge malere, der under indflydelse af Wilhelm Wanschers teorier om den italienske renæssance søgte at definere et moderne figurmaleri i \"Den store Stil\". R. havde et religiøst gemyt og fandt sine motiver i de bibelske tekster. R. arbejdede først i et ekspressionistisk formsprog under indtryk fra El Greco, men vendte sig siden mod Giotto og Masaccio foruden kubismen. Hans fortolkning af de store forbilleder var styret af et skarpt intellekt og en selvstændig opfattelse af farvens dramatiske kvaliteter. R. var nevø af Bertha Wegmann, og sideløbende med sit figurmaleri malede han på bestilling portrætter i hendes stil. R. var en rastløs begavelse og var først for alvor ved at nå frem til et personligt udtryk, da han døde kun 32 år gammel.","creator_lref":"11615_person"}],"production_date":[{"start":"1919-01-01T00:00:00.000Z","end":"1920-12-31T00:00:00.000Z","period":"1919-1920"}],"techniques":["Oil on canvas"],"titles":[{"title":"The Heavenly Wedding. Emmanuel Sweborg: Amore Conjugiali","language":"engelsk"}],"number_of_parts":1,"object_number":"KMS8395","object_url":"h