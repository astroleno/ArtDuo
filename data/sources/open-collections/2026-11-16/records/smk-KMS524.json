{"id":"1170024960_object","created":"2020-03-21T13:12:42Z","modified":"2025-07-11T17:37:11Z","acquisition_date":"1846-01-01T00:00:00Z","acquisition_date_precision":"1846-12-31","dimensions":[{"notes":"760 x 985 mm","part":"Netto","type":"height","unit":"cm","value":"76"},{"notes":"760 x 985 mm","part":"Netto","type":"width","unit":"cm","value":"98.5"}],"documentation":[{"title":"Italiens smukkeste egn: dansk guldalder i Albano, Frascati og Nemi","author":"Ida Haugsted","notes":"afb. p. 157 (fig. 112)","shelfmark":"2004-006","year_of_publication":"2003"},{"title":"Rammens kunst","author":"Henrik Bjerre","notes":"ill. p. 75","shelfmark":"C 39796","year_of_publication":"2008"},{"title":"Danske malere i Rom i det 19. århundrede: Statens Museum for Kunst december 1977 - januar 1978","author":"Ubekendt","notes":"kat. 48.","shelfmark":"46369","year_of_publication":"1977"}],"exhibitions":[{"exhibition":"Her i Italien... H.C. Andersen og guldaldermalerne","date_start":"2005-02-12T00:00:00.000Z","date_end":"2005-06-12T00:00:00.000Z","venue":"SMK København"}],"inscriptions":[{"content":"Thorald Læssøe Roma 1845.","type":"signature"}],"materials":["canvas"],"object_names":[{"name":"Painting"}],"production":[{"creator":"Læssøe, Thorald","creator_forename":"Thorald","creator_surname":"Læssøe","creator_date_of_birth":"1816-06-25T00:00:00.000Z","creator_date_of_death":"1878-03-25T00:00:00.000Z","creator_nationality":"Danish","creator_gender":"MALE","creator_history":"Thorald Læssøes landskabskunst er gennemsyret af guldalderens kultur. Han hørte til i kredsen omkring J.Th. Lundbye og P.C. Skovgaard, til hvem han også knyttede sig i sin opfattelse af det sjællandske landskab med motiver fra bl.a. Arresø og Nordvestsjælland, og han var en nær ven af Lorenz Frölich og J.A. Jerichau. Han arbejdede i sin ungdom tæt op ad Købke, og flere af hans værker er blevet forvekslet med dennes. Fra hans mangeårige ophold i Italien findes en mængde landskaber, hvor såvel helhedens lysvirkninger som detaljernes finesse vidner om et sobert talent. I arkitekturstykkerne viser ånden fra den Eckersbergske skole sig markant. Med sine figurstaffager, hyrder, jægere etc. bibragte han ofte sine landskaber og arkitekturstykker et romantisk islæt. Nogle få gange forsøgte L. sig endog med rene genrestykker i Ernst Meyers og Albert Küchlers stil. Som enkemand tog han for anden gang ophold i Rom med sine to børn 1866- 68.","creator_lref":"699_person"}],"production_date":[{"start":"1845-01-01T00:00:00.000Z","end":"1845-12-31T00:00:00.000Z","period":"1845"}],"techniques":["Oil on canvas"],"titles":[{"title":"View of the Terme di Caracalla in Rome","language":"engelsk"}],"number_of_parts":1,"object_number":"KMS524","object_url":"https://api.smk.dk/api/v1/art?object_number=KMS524","frontend_url":"https://open.smk.dk/artwork/image/KMS524","iiif_manifest":"https://api.smk.dk/api/v1/iiif/manifest?id=KMS524","enrichment_url":"https://enrichment.api.smk.dk/api/enrichment/KMS524","similar_images_url":"https://similar.api.smk.dk/similar/?object_number=KMS524","production_dates_notes":["Værkdatering: 1845"],"public_domain":true,"rights":"https://creativecommons.org/publicdomain/mark/1.0/","on_display":false,"alternative_images":[{"mime_type":"image/tiff","iiif_id":"https://iip.smk.dk/iiif/jp2/qv33rx490_KMS524.tif.jp2","iiif_info":"https://iip.smk.dk/iiif/jp2/qv33rx490_KMS524.tif.jp2/info.json","width":4724,"height":4098,"size":20035235.862068966,"thumbnail":"https://iip-thumb.smk.dk/iiif/jp2/qv33rx490_KMS524.tif.jp2/full/!1024,/0/default.jpg","native":"https://iip.smk.dk/iiif/jp2/qv33rx490_KMS524.tif.jp2/full/full/0/native.jpg","orientation":"landscape"}],"image_mime_type":"image/tiff","image_iiif_id":"https://iip.smk.dk/iiif/jp2/rx913s883_KMS524.tif.reconstructed.tif.jp2","image_iiif_info":"https://iip.smk.dk/iiif/jp2/rx913s883_KMS524.tif.reconstructed.tif.jp2/info.json","image_width":3116,"image_height":2293,"image_size":4422237,"image_thumbnail":"https://iip-thumb.smk.dk/iiif/jp2/r