ede dels traditionelle opstillinger, hvor blomsterne eller frugterne blev kombineret med kostbare genstande og placeret på et marmorbord eller en piedestal, dels mere frie sammensætninger af mark- og skovblomster. L. var en af tidens få professionelle kvindelige kunstnere og blev anerkendt, bl.a. gennem salg til Den kongelige Malerisamling, det senere Statens Museum for Kunst. Hun havde et tegne- og malekursus i sit hjem, og blandt hendes elever var skuespilleren Johanne Louise Heiberg, forfatteren Benedicte Arnesen-Kall og den senere landskabsmaler Eleonore Christine Tscherning.","creator_lref":"2851_person"}],"production_date":[{"start":"1832-01-01T00:00:00.000Z","end":"1832-12-31T00:00:00.000Z","period":"1832"}],"techniques":["Oil on canvas"],"number_of_parts":1,"object_number":"KMS1260","object_url":"https://api.smk.dk/api/v1/art?object_number=KMS1260","frontend_url":"https://open.smk.dk/artwork/image/KMS1260","iiif_manifest":"https://api.smk.dk/api/v1/iiif/manifest?id=KMS1260","enrichment_url":"https://enrichment.api.smk.dk/api/enrichment/KMS1260","similar_images_url":"https://similar.api.smk.dk/similar/?object_number=KMS1260","production_dates_notes":["Værkdatering: 1832"],"public_domain":true,"rights":"https://creativecommons.org/publicdomain/mark/1.0/","on_display":true,"alternative_images":[{"mime_type":"image/tiff","iiif_id":"https://iip.smk.dk/iiif/jp2/xp68kh02m_KMS1260.tif.jp2","iiif_info":"https://iip.smk.dk/iiif/jp2/xp68kh02m_KMS1260.tif.jp2/info.json","width":2753,"height":3690,"size":10519699.310344828,"thumbnail":"https://iip-thumb.smk.dk/iiif/jp2/xp68kh02m_KMS1260.tif.jp2/full/!1024,/0/default.jpg","native":"https://iip.smk.dk/iiif/jp2/xp68kh02m_KMS1260.tif.jp2/full/full/0/native.jpg","orientation":"portrait"},{"mime_type":"image/tiff","iiif_id":"https://iip.smk.dk/iiif/jp2/j098zf046_KMS1260.tif.reconstructed.tif.jp2","iiif_info":"https://iip.smk.dk/iiif/jp2/j098zf046_KMS1260.tif.reconstructed.tif.jp2/info.json","width":2612,"height":3013,"size":61