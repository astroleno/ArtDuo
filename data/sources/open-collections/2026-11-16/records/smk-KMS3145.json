{"id":"1170016248_object","created":"2020-03-21T11:35:31Z","modified":"2025-07-11T17:33:19Z","acquisition_date":"1912-01-01T00:00:00Z","acquisition_date_precision":"1912-12-31","dimensions":[{"notes":"1180 x 1650 mm","part":"Netto","type":"height","unit":"cm","value":"118"},{"notes":"1180 x 1650 mm","part":"Netto","type":"width","unit":"cm","value":"165"},{"notes":"1360 x 1832 x 81 mm","part":"Brutto","type":"height","unit":"cm","value":"136"},{"notes":"1360 x 1832 x 81 mm","part":"Brutto","type":"width","unit":"cm","value":"183.2"},{"notes":"1360 x 1832 x 81 mm","part":"Brutto","type":"depth","unit":"cm","value":"8.1"}],"documentation":[{"title":"Kunstens Historie i Danmark","author":"Karl Madsen","notes":"p. 224f, 227 (afb.).","shelfmark":"11048","year_of_publication":"1901-1907"},{"title":"Danmarks Malerkunst 1-2: Billeder og Biografier","author":"Ch. A. Been","notes":"bd. 1, p. 69. 108, 111 (afb.).","shelfmark":"1678","year_of_publication":"1902-1903"},{"title":"København før og nu - og aldrig: en billed-kavalkade om København inden for voldene og søerne","author":"Bo Bramsen","notes":"bd. 10, Erik Wassard, Nørrevold, Østervold og Kastellet (1990), p. 186.","shelfmark":"D 22318:1-12","year_of_publication":"cop. 1987-1993"},{"title":"København. Interiører og prospekter 1800-1860","author":"Jørgen B. Hartmann","notes":"p. IXf, fig. 41.","year_of_publication":"1948"},{"title":"175 års jubilæum - Kunstnerforeningen af 18. november","author":"Tove Thage","notes":"afb. p. 38","year_of_publication":"2017"}],"exhibitions":[{"exhibition":"Langelinie - på kanten","date_start":"2013-02-02T00:00:00.000Z","date_end":"2013-05-05T00:00:00.000Z","venue":"Esbjerg Kunstmuseum"}],"inscriptions":[{"content":"AHunæus. 1862.","type":"signature"}],"materials":["canvas"],"object_names":[{"name":"Painting"}],"production":[{"creator":"Hunæus, Andreas Herman","creator_forename":"Andreas Herman","creator_surname":"Hunæus","creator_date_of_birth":"1814-12-08T00:00:00.000Z","creator_date_of_death":"1866-05-15T00:00:00.000Z","creator_nationality":"Danish","creator_gender":"MALE","creator_history":"Andreas Herman Hunæus forsøgte sig tidligt som landskabsmaler, primært med motiver fra Københavns omegn og landskabet omkring fødebyen Kolding, men hovedindsatsen blev genre- og især portrætmaleri. Eftertiden har valgt at placere H. blandt de ukendte guldaldermalere, men han var en af sin samtids mest benyttede portrætmalere med en vidtspændende kundekreds, der talte såvel kongelige som borgerlige og håndværkere. Populariteten skyldtes især kunstnerens udtalte evne til at levere den ønskede portrætlighed, der i de bedste eksempler kombineredes med en fin fornemmelse for den individuelle karaktertegning. Den rammende karakteristik er også det bærende element i kunstnerens mest kendte billede På Københavns Vold aftenen før Store Bededag, en af periodens relativt sjældne skildringer af borgerligt folkeliv med kendte og ukendte københavnere i H.s anekdotiske og meget frie iscenesættelse. H.s genremaleri er ellers ikke præget af den store originalitet. Det føjer sig i reglen til C.A. Schleisner og J. Exners muntre bondelivsskildringer, men savner en sikker formbehandling og evne til at skabe en overbevisende sammenhæng mellem figur og rum. H. udførte desuden en række billeder med religiøse motiver, deriblandt flere altertavler, der vidner om indflydelsen fra akademiprofessoren J.L. Lunds idealiserede, Nazarener-inspirerede, religiøse maleri, medens hans portrætter i højere grad er beslægtet med Eckersberg-elevernes mere realistiske motivopfattelse.","creator_lref":"544_person"}],"production_date":[{"start":"1862-01-01T00:00:00.000Z","end":"1862-12-31T00:00:00.000Z","period":"1862"}],"techniques":["Oil on canvas"],"titles":[{"title":"Promenading on the Ramparts of Copenhagen on the Evening of a Public Holiday in Spring","language":"engelsk"}],"number_of_parts":1,"object_number":"KMS3145","object_url":"https://api.smk.dk/api/v1/art?object_number=KMS3145","frontend_ur