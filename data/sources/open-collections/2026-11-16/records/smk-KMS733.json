{"id":"1170091031_object","created":"2020-03-22T01:53:38Z","modified":"2025-07-11T18:09:36Z","acquisition_date":"1855-01-01T00:00:00Z","acquisition_date_precision":"1855-12-31","dimensions":[{"notes":"1365 x 2060 mm","part":"Netto","type":"height","unit":"cm","value":"136.5"},{"notes":"1365 x 2060 mm","part":"Netto","type":"width","unit":"cm","value":"206"}],"inscriptions":[{"content":"fnth: F.C.Kiærschou 1855","type":"Inscription"}],"materials":["canvas"],"object_names":[{"name":"Painting"}],"production":[{"creator":"Kiærskou, F.C.","creator_forename":"F.C.","creator_surname":"Kiærskou","creator_date_of_birth":"1805-03-26T00:00:00.000Z","creator_date_of_death":"1891-06-05T00:00:00.000Z","creator_nationality":"Danish","creator_gender":"MALE","creator_history":"F.C. Kiærskou valgte tidligt at uddanne sig til landskabsmaler og var elev af Eckersberg og J.L. Lund på Kunstakademiet. Størst indflydelse fik den af Lund promoverede tysk-romantiske landskabstradition, der koloristisk og kompositionelt havde rod i hollandsk 1600-tals maleri, og livet igennem forblev fundamentet for K.s landskabsopfattelse. Som L. Gurlitt og Th. Brendstrup repræsenterede K. et internationalt landskabsmaleri, der med udgangspunkt i bl.a. Ruisdael og J.C. Dahl fremhævede landskabets dramatiske og storladne karakter, hvad enten motiverne var danske eller som ofte de schweiziske alper. Manglende vilje til at assimilere Eckersberg-skolens præ-naturalistiske landskabssyn har givet K. en perifær placering i 1800-tallets danske landskabskunst på linie med andre kunstnere, der fastholdt et romantisk-idealistisk kunstsyn.","creator_lref":"1101_person"}],"production_date":[{"start":"1855-01-01T00:00:00.000Z","end":"1855-12-31T00:00:00.000Z","period":"1855"}],"techniques":["Oil on canvas"],"number_of_parts":1,"object_number":"KMS733","object_url":"https://api.smk.dk/api/v1/art?object_number=KMS733","frontend_url":"https://open.smk.dk/artwork/image/KMS733","iiif_manifest":"https://api.smk.dk/api/v1/iiif/m