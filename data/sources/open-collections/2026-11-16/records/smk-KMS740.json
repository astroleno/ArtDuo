{"id":"1170090892_object","created":"2020-03-22T01:51:14Z","modified":"2025-07-11T18:09:31Z","backside_protection":true,"acquisition_date":"1856-01-01T00:00:00Z","acquisition_date_precision":"1856-12-31","dimensions":[{"notes":"630 x 890 mm","part":"Netto","type":"height","unit":"cm","value":"63"},{"notes":"630 x 890 mm","part":"Netto","type":"width","unit":"cm","value":"89"},{"notes":"774 x 1036 x 62 mm","part":"Brutto","type":"height","unit":"cm","value":"77.4"},{"notes":"774 x 1036 x 62 mm","part":"Brutto","type":"width","unit":"cm","value":"103.6"},{"notes":"774 x 1036 x 62 mm","part":"Brutto","type":"depth","unit":"cm","value":"6.2"}],"documentation":[{"title":"Fogtdals kunstleksikon","author":"Ubekendt","notes":"bd. 8 (Mani-Nord), p. 84f (afb. i farver).","shelfmark":"53508","year_of_publication":"1988-1992"}],"exhibitions":[{"exhibition":"Kunsten i nederlagets skygge","date_start":"2023-05-11T00:00:00.000Z","date_end":"2023-09-17T00:00:00.000Z","venue":"Kunstmuseet Brundlund Slot"}],"inscriptions":[{"content":"D Monies pinx.","type":"signature"}],"materials":["canvas"],"object_names":[{"name":"Painting"}],"production":[{"creator":"Monies, David","creator_forename":"David","creator_surname":"Monies","creator_date_of_birth":"1812-06-03T00:00:00.000Z","creator_date_of_death":"1894-04-30T00:00:00.000Z","creator_nationality":"Danish","creator_gender":"MALE","creator_history":"David Monies udviste tidligt evner i tegnekunsten, og han kom som 12-årig, trods familiens fattigdom, på Kunstakademiet. Han ernærede sig allerede da ved at tegne portrætter, og fra 1830rne blev han en af landets mest efterspurgte portrætmalere. Det er da også først og fremmest for rækken af solidt udførte portrætter, eftertiden vil huske ham. Hans karakteristik er sjældent dybdeborende, og malerisk spores der ofte nogen tørhed. Hans portrætter, især skuespillerportrætterne, er værdifulde for deres dokumentariske udsagn, idet det altid lykkedes for ham at opnå stor portrætlighed. Han udførte en del af sine portrætter i litografier af høj kunstnerisk kvalitet, hvorfor de vandt stor udbredelse og popularitet. Det samme gjaldt hans skildring af soldaternes hjemkomst i 1849. I samtiden værdsattes endvidere hans genrebilleder, der trods deres småborgerlige lune ofte er lovlig udpenslede i deres forsøg på at fastslå en sentimentalt-naiv pointe.","creator_lref":"336_person"}],"production_date":[{"start":"1854-01-01T00:00:00.000Z","end":"1855-12-31T00:00:00.000Z","period":"1854-1855"}],"techniques":["Oil on canvas"],"titles":[{"title":"A Coffee Party at a Gamekeeper's House","language":"engelsk"}],"number_of_parts":1,"object_number":"KMS740","object_url":"https://api.smk.dk/api/v1/art?object_number=KMS740","frontend_url":"https://open.smk.dk/artwork/image/KMS740","iiif_manifest":"https://api.smk.dk/api/v1/iiif/manifest?id=KMS740","enrichment_url":"https://enrichment.api.smk.dk/api/enrichment/KMS740","similar_images_url":"https://similar.api.smk.dk/similar/?object_number=KMS740","production_dates_notes":["Værkdatering: Ca. 1856","Udstillet på Charlottenborg i 1856"],"public_domain":true,"rights":"https://creativecommons.org/publicdomain/mark/1.0/","on_display":false,"image_mime_type":"image/tiff","image_iiif_id":"https://iip.smk.dk/iiif/jp2/44558j37z_kms740.tif.jp2","image_iiif_info":"https://iip.smk.dk/iiif/jp2/44558j37z_kms740.tif.jp2/info.json","image_width":5751,"image_height":4024,"image_size":23952543,"image_thumbnail":"https://iip-thumb.smk.dk/iiif/jp2/44558j37z_kms740.tif.jp2/full/!1024,/0/default.jpg","image_native":"https://api.smk.dk/api/v1/download/W3siaW1nX3VybCI6Imh0dHBzOi8vaWlwLnNtay5kay9paWlmL2pwMi80NDU1OGozN3pfa21zNzQwLnRpZi5qcDIvZnVsbC9mdWxsLzAvbmF0aXZlLmpwZyIsInB1YmxpY19kb21haW4iOnRydWUsIm9iamVjdF9udW1iZXIiOiJLTVM3NDAiLCJudW0iOiIifV0=/KMS740.jpg","image_orientation":"landscape","image_hq":true,"has_3d_file":false,"has_image":true,"colors":["#222222","#3a351f","#2c3b20","#111111","#5a5527","#bbbbbb"],"suggested_bg_color":["#5a5527"],"entropy":9