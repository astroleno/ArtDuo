{"id":"1170015505_object","created":"2020-03-21T11:27:06Z","modified":"2026-10-07T08:01:15Z","acquisition_date":"1832-01-01T00:00:00Z","acquisition_date_precision":"1832-12-31","dimensions":[{"notes":"505 x 430 mm","part":"Netto","type":"height","unit":"cm","value":"50.5"},{"notes":"505 x 430 mm","part":"Netto","type":"width","unit":"cm","value":"43"},{"part":"Brutto","type":"height","unit":"cm","value":"57.3"},{"part":"Brutto","type":"width","unit":"cm","value":"50.6"},{"part":"Brutto","type":"depth","unit":"cm","value":"5.3"}],"exhibitions":[{"exhibition":"\"Danish Golden Age\" Petit Palais","date_start":"2020-04-27T00:00:00.000Z","date_end":"2020-08-25T00:00:00.000Z","venue":"Petit Palais"},{"exhibition":"Dansk guldålder / The Danish Golden Age","date_start":"2019-02-28T00:00:00.000Z","date_end":"2019-07-21T00:00:00.000Z","venue":"Nationalmuseum, Stockholm"},{"exhibition":"Dansk Guldalder: Verdenskunst mellem to katastrofer","date_start":"2019-08-24T00:00:00.000Z","date_end":"2019-12-08T00:00:00.000Z","venue":"SMK København"},{"exhibition":"Kunst på bordet!","date_start":"2026-10-10T00:00:00.000Z","date_end":"2027-08-22T00:00:00.000Z","venue":"Kunstmuseum Brandts"},{"exhibition":"Kunst på bordet!","date_start":"2027-09-08T00:00:00.000Z","date_end":"2028-01-16T00:00:00.000Z","venue":"Nivaagaards Malerisamling"}],"inscriptions":[{"content":"fnth: H:Neergaard. 1831.","type":"Inscription"}],"materials":["metals"],"object_names":[{"name":"Painting"}],"production":[{"creator":"Neergaard, Hermania","creator_forename":"Hermania","creator_surname":"Neergaard","creator_date_of_birth":"1799-08-12T00:00:00.000Z","creator_date_of_death":"1875-03-25T00:00:00.000Z","creator_nationality":"Danish","creator_gender":"FEMALE","creator_history":"Hermania Neergaards først udstillede arbejde på Charlottenborg var en kopi efter et blomsterstykke af læreren F.C. Camradt, udført i gouache, et materiale som de lidt ældre danske blomstermalere havde dyrket. Senere arbejdede hun i oliefarver med motiver som blomster sat i glas, skåle og kurve, blomster og frugter liggende på et bord og i sine senere år især vilde blomster eller groende planter. Et særligt motiv, der dyrkedes i Thorvaldsens kreds, og som N. benyttede første gang 1831, var blomster sat i \"etruriske\" vaser (græske og italiske vaser fundet især i Etrurien). Få år efter ses dette nyklassicistiske motiv også hos den jævnaldrende J.L. Jensen, hvis beundrede frugt- og blomsterstykker hun tog indtryk af, selv om hendes stil var mindre farverig og plastisk end hans. N. tilhørte den kreds af kunstnere, der færdedes på Nysø, og Thorvaldsen købte et maleri til sin samling af hende, ligesom også Christian VIII og Frederik VII erhvervede hendes billeder.","creator_lref":"2691_person"}],"production_date":[{"start":"1831-01-01T00:00:00.000Z","end":"1831-12-31T00:00:00.000Z","period":"1831"}],"techniques":["Oil on metal"],"number_of_parts":1,"object_number":"KMS1256","object_url":"https://api.smk.dk/api/v1/art?object_number=KMS1256","frontend_url":"https://open.smk.dk/artwork/image/KMS1256","iiif_manifest":"https://api.smk.dk/api/v1/iiif/manifest?id=KMS1256","enrichment_url":"https://enrichment.api.smk.dk/api/enrichment/KMS1256","similar_images_url":"https://similar.api.smk.dk/similar/?object_number=KMS1256","production_dates_notes":["Værkdatering: 1831"],"public_domain":true,"rights":"https://creativecommons.org/publicdomain/mark/1.0/","on_display":false,"alternative_images":[{"mime_type":"image/tiff","iiif_id":"https://iip.smk.dk/iiif/jp2/d504rm25p_KMS1256.tif.jp2","iiif_info":"https://iip.smk.dk/iiif/jp2/d504rm25p_KMS1256.tif.jp2/info.json","width":2953,"height":3440,"size":10517226.206896553,"thumbnail":"https://iip-thumb.smk.dk/iiif/jp2/d504rm25p_KMS1256.tif.jp2/full/!1024,/0/default.jpg","native":"https://iip.smk.dk/iiif/jp2/d504rm25p_KMS1256.tif.jp2/full/full/0/native.jpg","orientation":"portrait"},{"mime_type":"image/tiff","iiif_id":"https://iip.smk.dk/iiif/jp2/b2773z595_KMS1256.tif.reconstruc