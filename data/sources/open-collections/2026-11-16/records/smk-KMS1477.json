 Et vist genrepræg ses i de italienske billeder, der har nydelig personstaffage. Hans billeder er altid velkomponerede og klare i opbygningen, med god sans for relationerne mellem forgrund og baggrund. Farverne er lokaltoner med megen præcision i lysvirkningerne. B.s malerier er ofte af høj æstetisk kvalitet og føjer sig ind i den bedre del af den danske guldaldertradition.","creator_lref":"530_person"}],"production_date":[{"start":"1855-01-01T00:00:00.000Z","end":"1855-12-31T00:00:00.000Z","period":"1855"}],"techniques":["Oil on canvas"],"titles":[{"title":"A Summer Morning beside the Deer Park Fence in Ordrup Spinney, North of Copenhagen","language":"engelsk"}],"number_of_parts":1,"object_number":"KMS1477","object_url":"https://api.smk.dk/api/v1/art?object_number=KMS1477","frontend_url":"https://open.smk.dk/artwork/image/KMS1477","iiif_manifest":"https://api.smk.dk/api/v1/iiif/manifest?id=KMS1477","enrichment_url":"https://enrichment.api.smk.dk/api/enrichment/KMS1477","similar_images_url":"https://similar.api.smk.dk/similar/?object_number=KMS1477","production_dates_notes":["Værkdatering: 1855"],"public_domain":true,"rights":"https://creativecommons.org/publicdomain/mark/1.0/","on_display":false,"alternative_images":[{"mime_type":"image/tiff","iiif_id":"https://iip.smk.dk/iiif/jp2/v405sb392_KMS1477.tif.jp2","iiif_info":"https://iip.smk.dk/iiif/jp2/v405sb392_KMS1477.tif.jp2/info.json","width":3971,"height":3097,"size":4250376.551724138,"thumbnail":"https://iip-thumb.smk.dk/iiif/jp2/v405sb392_KMS1477.tif.jp2/full/!1024,/0/default.jpg","native":"https://iip.smk.dk/iiif/jp2/v405sb392_KMS1477.tif.jp2/full/full/0/native.jpg","orientation":"landscape"}],"image_mime_type":"image/tiff","image_iiif_id":"https://iip.smk.dk/iiif/jp2/ff365909p_KMS1477_crop.tif.jp2","image_iiif_info":"https://iip.smk.dk/iiif/jp2/ff365909p_KMS1477_crop.tif.jp2/info.json","image_width":3784,"image_height":2665,"image_size":3486040,"image_thumbnail":"https://iip-thumb.smk.dk/iiif/jp2/ff365909p_KMS1